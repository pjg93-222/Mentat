; Downloads layout (D-300/D-303). The DL_* names and limits are generated by after-pack.cjs from install-layout.cjs
; (installer.generated.nsh defines them, then includes this file). Nothing here hard-codes a folder name.
!include FileFunc.nsh
; Order matters to tests/publisher-trust.test.cjs: customInstall stays the first macro. NSIS expands macro bodies only when they are
; inserted, so the helpers below may be defined after the macros that use them.
!macro customInstall
  ; Offline rollback baseline: an interactive (non-update) install keeps a copy of its own installer in the
  ; per-user baseline folder the app reads (main.cjs baselineRoot). The first rollback then needs no download;
  ; the app re-verifies the hash and the publisher before using it. Nothing elevated; any failure is ignored.
  ; Update trust is not set here: the app asks once at its first interactive launch (publisher-trust.cjs).
  ; Per-machine (all users) installs skip it: the app reads the signed-in user's %LOCALAPPDATA%, which may not be the
  ; (elevated) installing account's, so their first rollback falls back to a network download.
  ${IfNot} ${isUpdated}
  ${AndIfNot} ${Silent}
  ${AndIf} $installMode == "CurrentUser"
    ClearErrors
    CreateDirectory "$LOCALAPPDATA\${APP_ID}\baseline\${VERSION}"
    CopyFiles /SILENT "$EXEPATH" "$LOCALAPPDATA\${APP_ID}\baseline\${VERSION}\$EXEFILE"
    ClearErrors
  ${EndIf}
  ; Downloads layout: the uninstaller of the folder it sits in, with _?= last so the old uninstaller runs in place during an
  ; update (electron-builder's GetInQuotes still reads the quoted exe).
  !insertmacro dlRoot
  !insertmacro dlInstdirUnderRoot
  ${If} $R1 == "1"
    WriteRegStr SHELL_CONTEXT "${UNINSTALL_REGISTRY_KEY}" UninstallString '"$INSTDIR\${UNINSTALL_FILENAME}" /currentuser _?=$INSTDIR'
    WriteRegStr SHELL_CONTEXT "${UNINSTALL_REGISTRY_KEY}" QuietUninstallString '"$INSTDIR\${UNINSTALL_FILENAME}" /currentuser /S _?=$INSTDIR'
    ClearErrors
    FileOpen $R4 "$R0\README - do not delete.txt" w
    ${IfNot} ${Errors}
      FileWrite $R4 "This folder holds Melange Systems desktop applications and their updates. Do not delete it while they are in use.$\r$\n"
      FileClose $R4
    ${EndIf}
    ClearErrors
  ${EndIf}
!macroend
!macro customUnInstall
  ${IfNot} ${isUpdated}
    ; Remove only this application's login task and its cached installers (rollback baseline and updater cache;
    ; update state lives in the profile). Keep user data and credentials. The release certificate stays trusted:
    ; all three apps share it.
    DeleteRegValue HKCU "Software\Microsoft\Windows\CurrentVersion\Run" "${APP_ID}"
    DeleteRegValue HKCU "Software\Microsoft\Windows\CurrentVersion\Explorer\StartupApproved\Run" "${APP_ID}"
    RMDir /r "$LOCALAPPDATA\${APP_ID}\baseline"
    RMDir /r "$LOCALAPPDATA\${APP_ID}\updater"
    RMDir "$LOCALAPPDATA\${APP_ID}"
    ; Downloads layout: this app's electron-updater cache, then the updates and root folders only when empty.
    ; Never the root itself, and never another version folder.
    Push $R0
    Push $R1
    Push $R2
    Push $R3
    !insertmacro dlRoot
    RMDir /r "$R0\${DL_UPDATES_NAME}\${DL_CACHE_FOLDER}"
    RMDir "$R0\${DL_UPDATES_NAME}"
    ; The README and the root are shared by all apps: remove them only when nothing else is left in the root.
    StrCpy $R3 "0"
    FindFirst $R1 $R2 "$R0\*.*"
    ${DoWhile} $R2 != ""
      ${If} $R2 != "."
      ${AndIf} $R2 != ".."
      ${AndIf} $R2 != "README - do not delete.txt"
        StrCpy $R3 "1"
      ${EndIf}
      FindNext $R1 $R2
    ${Loop}
    FindClose $R1
    ${If} $R3 == "0"
      Delete "$R0\README - do not delete.txt"
      RMDir "$R0"
    ${EndIf}
    Pop $R3
    Pop $R2
    Pop $R1
    Pop $R0
  ${EndIf}
!macroend
; Per-user only, no install-mode page: the page's LEAVE handler would otherwise reset $INSTDIR to the registry or
; %LOCALAPPDATA%\Programs location, and "anyone who uses this computer" offers elevation and Program Files.
!macro customInstallMode
  StrCpy $isForceCurrentInstall "1"
!macroend
; Page hook after the (absent) directory page: re-apply the Downloads folder after setInstallModePerUser has reset $INSTDIR,
; then Abort so the page never shows. Silent runs skip pages and keep the customInit result.
!macro customPageAfterChangeDir
  Function dlReforceInstdir
    !insertmacro dlPlaceInstdir
    Abort
  FunctionEnd
  Page custom dlReforceInstdir
!macroend
; A generated include left over from another build would carry the wrong folder name and limits.
!macro dlGuard
  !if "${DL_BUILD_VERSION}" != "${VERSION}"
    !error "installer.generated.nsh is stale: built for ${DL_BUILD_VERSION}, packaging ${VERSION}"
  !endif
!macroend
; $R0 <- <Downloads>\${DL_ROOT_NAME}. Plugin-free: User Shell Folders + ExpandEnvStrings, fallback $PROFILE\Downloads.
!macro dlRoot
  !ifdef DL_TEST_ROOT
    StrCpy $R0 "${DL_TEST_ROOT}"
  !else
    ReadRegStr $R0 HKCU "Software\Microsoft\Windows\CurrentVersion\Explorer\User Shell Folders" "${DL_KNOWN_FOLDER}"
    ExpandEnvStrings $R0 $R0
    ${If} $R0 == ""
      StrCpy $R0 "$PROFILE\Downloads"
    ${EndIf}
    StrCpy $R0 "$R0\${DL_ROOT_NAME}"
  !endif
!macroend
; $R1 <- "1" when $INSTDIR is under $R0 (NSIS StrCmp is case-insensitive). Callers supply $R0.
!macro dlInstdirUnderRoot
  StrLen $R2 "$R0\"
  StrCpy $R3 "$INSTDIR" $R2
  StrCpy $R1 "0"
  ${If} $R3 == "$R0\"
    StrCpy $R1 "1"
  ${EndIf}
!macroend
; $R8 <- "1" when this installer runs from <root>\updates\<app>\... , i.e. electron-updater's pending cache. That location,
; not /D=, identifies a layout update: Node quotes a /D= value that contains a space and NSIS then ignores it. Callers supply $R0.
!macro dlExedirPending
  StrLen $R2 "$R0\${DL_UPDATES_NAME}\${DL_CACHE_FOLDER}\"
  StrCpy $R3 "$EXEDIR\" $R2
  StrCpy $R8 "0"
  ${If} $R3 == "$R0\${DL_UPDATES_NAME}\${DL_CACHE_FOLDER}\"
    StrCpy $R8 "1"
  ${EndIf}
!macroend
; Decide $INSTDIR (needs plugins loaded for isUpdated; the harness defines a stand-in).
;  - run from the pending cache (update or rollback): <root>\${DL_APP_FOLDER}, this installer's own version; if that path is too
;    long, keep the registered location (the update then installs in place).
;  - otherwise not an update and not already under the root: force <root>\${DL_APP_FOLDER}, refusing an over-long path.
;  - otherwise keep it (an old-layout in-place update, or a folder already under the root).
!macro dlPlaceInstdir
  !insertmacro dlRoot
  !insertmacro dlInstdirUnderRoot
  !insertmacro dlExedirPending
  ${If} $R8 == "1"
  ${AndIf} ${isUpdated}
    StrCpy $R6 "$R0\${DL_APP_FOLDER}"
    StrLen $R2 "$R6"
    ${If} $R2 <= ${DL_MAX_DIR}
      StrCpy $INSTDIR "$R6"
    ${EndIf}
  ${ElseIf} $R1 != "1"
  ${AndIfNot} ${isUpdated}
    StrCpy $INSTDIR "$R0\${DL_APP_FOLDER}"
    StrLen $R2 "$INSTDIR"
    ${If} $R2 > ${DL_MAX_DIR}
      MessageBox MB_OK|MB_ICONSTOP "The install folder would be too long for Windows:$\r$\n$INSTDIR$\r$\n$\r$\nUse a shorter Windows user name or Downloads location, or tell IT this path." /SD IDOK
      Quit
    ${EndIf}
  ${EndIf}
!macroend
; Runs first in .onInit, before any plugin. It uses only NSIS built-ins, LogicLib and FileFunc script functions, because a
; plugin call would initialise $PLUGINSDIR in the original %TEMP%. NSIS has already applied an unquoted /D= to $INSTDIR here.
; TEMP moves for a manual install, for a run from the pending cache, and when $INSTDIR is already under the root. It does not
; move for an old-layout in-place update (--updated, not pending, $INSTDIR outside the root): D-6, an existing Documents install.
; Never runs in electron-builder's build-time uninstaller pass.
!macro preInit
  !insertmacro dlGuard
  !ifndef BUILD_UNINSTALLER
    !insertmacro dlRoot
    !insertmacro dlInstdirUnderRoot
    !insertmacro dlExedirPending
    ${GetParameters} $R4
    ClearErrors
    ${GetOptions} $R4 "--updated" $R5
    ${If} $R1 == "1"
    ${OrIf} $R8 == "1"
    ${OrIf} ${Errors}
      StrCpy $R6 "$R0\${DL_UPDATES_NAME}\${DL_SETUP_FOLDER}"
      StrLen $R7 $R6
      ${If} $R7 <= ${DL_MAX_SETUP}
        CreateDirectory $R6
        UnsafeStrCpy $TEMP $R6
        InitPluginsDir
        System::Call 'kernel32::SetEnvironmentVariable(t "TEMP", t "$TEMP")'
        System::Call 'kernel32::SetEnvironmentVariable(t "TMP", t "$TEMP")'
      ${EndIf}
    ${EndIf}
  !endif
!macroend
; Runs after initMultiUser, so plugins are loaded (from the moved TEMP).
!macro customInit
  !ifndef BUILD_UNINSTALLER
    !insertmacro dlPlaceInstdir
  !endif
!macroend
